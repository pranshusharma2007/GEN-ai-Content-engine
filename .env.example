# OmniFormat AI Engine — Environment Configuration
# SIH26154 · Team WildCard
# Copy to .env at the repo root and fill in. Everything is optional for local dev
# (the app runs with a dev user + local JSON history when unset).

# ── LLM providers (set at least one) ─────────────────────────────────────────
GROQ_API_KEY=
# Use a durable API key from https://aistudio.google.com/apikey (starts "AIza...").
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_BUDGET=0        # 0 = thinking off (latency); raise only if quality needs it
GEMINI_TIMEOUT_MS=30000         # slow Gemini call fails fast → auto-fallback to Groq

# Per-FORMAT generation routing — each selected output format's agent runs on its
# assigned provider (same source input for all). MVP providers: groq | gemini.
# Falls back to the other provider automatically if the assigned one fails.
LLM_FORMAT_LINKEDIN=groq
LLM_FORMAT_X_THREAD=groq
LLM_FORMAT_ADVISORY=gemini
LLM_FORMAT_EXECUTIVE_SUMMARY=gemini
LLM_FORMAT_PRESENTATION=gemini
LLM_FORMAT_INFOGRAPHIC=gemini

# Per-task routing for the shared analysis passes (defaults shown).
LLM_TASK_GROUND_TRUTH=groq
LLM_TASK_VERIFY=groq
LLM_TASK_CONSISTENCY=groq
LLM_TASK_DIFF=groq

# ── Firebase Authentication ─────────────────────────────────────────────────
# Backend token verification (first that applies):
#   1. FIREBASE_SERVICE_ACCOUNT_JSON / _PATH  → full firebase-admin
#   2. FIREBASE_PROJECT_ID only               → verify ID tokens via google-auth
#      (enough for login; no service account needed)
#   3. neither                                → dev-bypass
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
# true = a missing/invalid token is 401 (no dev-bypass fallback).
AUTH_REQUIRED=false

# Frontend (Vite) — Firebase console → Project settings → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_URL=

# ── Supabase (history persistence) ─────────────────────────────────────────
# Run gen-ai-content-engine/backend/supabase_schema.sql once in the SQL editor.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_TABLE=transformations

# ── SMTP (no email feature wired yet — staged for a future "email me the package") ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# ── App wiring ─────────────────────────────────────────────────────────────
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_GEN_AI_API_URL=http://localhost:8000
